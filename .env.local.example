# Copy to .env.local (git-ignored) and fill in. Checked at start-up by src/lib/validations/env.ts (Zod).
# Restart `pnpm dev` after every change to this file. Full guide: README "Setup cepat anggota tim (Windows)".
# Never commit .env.local and never post its values in a group chat.

# --- Supabase ------------------------------------------------------------------------------------------------
# Team members: ask the Koor Tech for these two by private message (the team's DEV project).
# Your own project instead (README "Setup mandiri penuh"): Project Settings -> API -> Project URL and anon key.
NEXT_PUBLIC_SUPABASE_URL=https://isi-dari-koor.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-dari-koor

# Leave this dummy. Only admin tools (LO accounts, CP judging, push) use it, never the registration flow.
# Your own Supabase project only: its service_role key (Project Settings -> API). Never ask for the team's.
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key

# --- Cloudinary: YOUR OWN free account (server only) ---------------------------------------------------------
# Needed to upload the payment proof when registering a team. Sign up at https://cloudinary.com (free), then
# Console -> Settings (gear icon) -> API Keys: copy "Cloud name", "API Key" and "API Secret".
# With the placeholders below the site still runs, but uploading the payment proof fails.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Judge0: dummy (server only) -----------------------------------------------------------------------------
# Only judges CP contest submissions. Never point this at the team's Judge0.
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=dummy-judge0-token

# --- Web push: leave commented out ---------------------------------------------------------------------------
# Optional. An empty value (e.g. VAPID_PRIVATE_KEY=) fails validation, so keep these three lines commented out.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- DEV contest seed (pnpm seed:cp, see docs/dev-seed-cp.md) ------------------------------------------------
# Password for the seeded e2e-cp-NN@nplc.test accounts. Only read by the seed script, never by the app.
# E2E_CP_PASSWORD=
