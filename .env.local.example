NEXT_PUBLIC_SUPABASE_URL=https://your-self-hosted-supabase-domain
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_MCP_KEY=your-supabase-mcp-key

# Cloudinary (server-only)
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@dguog28cy
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Self-hosted Judge0 (server-only)
JUDGE0_URL=https://your-judge0-host
JUDGE0_AUTH_TOKEN=your-judge0-auth-token

# Web push notifications (optional). Generate a key pair with: pnpm exec web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:committee@example.com
